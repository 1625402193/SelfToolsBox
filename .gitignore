# 依赖
node_modules/

# 构建产物
dist/
release/
release2/
publish/

# 打包日志
*.log
*.err
build-*.log
build-*.err

# 编辑器 / 系统
.DS_Store
Thumbs.db
.vscode/
.idea/

# 临时文件
$null
*.tmp
*.asar

# 日报/周报/月报数据（个人工作记录，不纳入版本管理）
# 注：目录本身通过 .gitkeep 保留，程序首次运行会自动创建缺失的 txt
electron/data/*.txt

# 批量复制图片的本地索引与操作日志
# 这些文件含有完整的本地磁盘路径与项目目录结构，属于个人数据，绝不上传。
# 正常情况下它们只写在系统用户目录（%APPDATA%/file-classifier-tools/）下，
# 这里的规则用于兜底，防止调试时把它们放进项目目录而误提交。
electron/data/*.json
electron/data/*.jsonl
image-copy-index/
image-copy-index*.json
image-copy-log*.jsonl
批量复制图片日志*.txt

# 应用配置（含用户自选的源/目标路径等个人信息）
app-config.json

# CodeBuddy 本地数据（notes.md 保留，其余本地缓存忽略）
.codebuddy/teams/
.codebuddy/automations/
